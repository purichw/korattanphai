VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PROJECT_PUBLISHABLE_KEY
# Static is for isolated fixtures; production archive uses the verified Supabase backend.
VITE_DATA_BACKEND=static

# Server/collector only. Never prefix these secrets with VITE_.
# Local commands optionally read .env.model-inputs.local (gitignored).
MODEL_INPUT_SOURCE_ID=local-demo
# Generate independent tokens: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MODEL_INPUT_API_TOKEN=
# Optional separate GET-only token for the team running the model.
MODEL_INPUT_READ_TOKEN=
MODEL_INPUT_PORT=8787
# Local server persists here; Vercel cannot use this file store.
MODEL_INPUT_DATA_DIR=.local/model-inputs
# Vercel API only; requires the additive model_input_batches migration first.
MODEL_INPUT_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
MODEL_INPUT_SUPABASE_SECRET_KEY=

# Optional named integration identities (server only), one configured source.
# Supply JSON via the secret manager; fields: id, role, sourceId, tokens (current + previous).
MODEL_INPUT_CLIENTS_JSON=
MODEL_INPUT_RATE_LIMIT_PER_MINUTE=60
MODEL_INPUT_DAILY_QUOTA=10000

# Operational telemetry is default-off. Enable both sides after quota migration,
# an approved log-retention policy and configured hosting log monitoring.
VITE_OPERATIONAL_TELEMETRY_ENABLED=false
OPERATIONAL_TELEMETRY_ENABLED=false
OPERATIONAL_TELEMETRY_ORIGINS=https://korattanphai.vercel.app
OPERATIONAL_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
OPERATIONAL_SUPABASE_SECRET_KEY=
# A separate 32+ character machine token for read-only readiness checks.
OPERATIONAL_HEALTH_TOKEN=
OPERATIONAL_MONITOR_URL=https://korattanphai.vercel.app
OPERATIONAL_CHECK_READINESS=false
