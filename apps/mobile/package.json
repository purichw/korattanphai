  "dependencies": {
    "@expo-google-fonts/google-sans": "^0.4.2",
    "@protobi/exceljs": "^4.4.0-protobi.10",
    "@supabase/supabase-js": "^2.116.0",
    "@xmldom/xmldom": "^0.9.12",
    "buffer": "^6.0.3",
    "d3-geo": "^3.1.1",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-build-properties": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "jszip": "^3.10.1",
    "lucide-react-native": "^1.47.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo start --dev-client --localhost --max-workers 2",
    "ios": "expo run:ios",
    "prebuild:ios": "expo prebuild --platform ios --no-clean --no-install",
    "typecheck": "tsc --noEmit",
    "test:brand": "node --test tests/brand-parity.test.mjs",
    "test:domain": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.mjs",
    "export:ios": "expo export --platform ios --max-workers 2",
    "check:dependencies": "expo install --check"
  },
  "private": true
